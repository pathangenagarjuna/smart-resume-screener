# Copy this file to ".env" and fill in your real key. Never commit the real .env file.

# Get this from https://console.anthropic.com -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to use for extraction + matching.
# claude-sonnet-5 is a good default (quality/cost balance).
# Use claude-haiku-4-5-20251001 for a cheaper/faster option, or claude-opus-4-8 for max quality.
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite file path (default is fine for local/dev use)
DATABASE_URL=sqlite:///./resume_screener.db
